# Copy to .env and fill in values.

# LLM provider: openai | anthropic
LLM_PROVIDER=openai

# Required for current provider
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Database (leave unset to use SQLite at dental.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/dental_dev

# Twilio (not needed until voice/WhatsApp work begins)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Speech services (not needed until voice work begins)
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

# Google Calendar OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
